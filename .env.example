# =============================================================
# PLATEFORME TÉLÉCOM — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs
# =============================================================

# Domaine public OU adresse IP du serveur.
# Sans nom de domaine, mettez directement l'IP publique (ex: DOMAIN=203.0.113.10)
# et générez un certificat auto-signé : bash infra/scripts/gen-selfsigned-cert.sh 203.0.113.10
DOMAIN=telecom.votredomaine.tg

# PostgreSQL
POSTGRES_DB=telecom_db
POSTGRES_USER=telecom_user
POSTGRES_PASSWORD=CHANGER_CE_MOT_DE_PASSE_FORT

# Redis
REDIS_PASSWORD=CHANGER_CE_MOT_DE_PASSE_REDIS

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGER_CE_MOT_DE_PASSE_MINIO

# JWT (générer avec: openssl rand -hex 64)
JWT_SECRET=GENERER_UNE_CLE_256_BITS_ALEATOIRE_ICI
JWT_REFRESH_SECRET=GENERER_UNE_AUTRE_CLE_256_BITS_ALEATOIRE

# NextAuth
NEXTAUTH_SECRET=GENERER_UNE_CLE_ALEATOIRE_NEXTAUTH

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alertes@votredomaine.tg
SMTP_PASS=MOT_DE_PASSE_EMAIL

# Firebase Cloud Messaging (push mobile)
FCM_SERVER_KEY=VOTRE_CLE_FCM_SERVER

# Grafana admin
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGER_MOT_DE_PASSE_GRAFANA
