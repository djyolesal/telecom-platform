generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local ; cible musl pour l'image Docker Alpine (node:20-alpine)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────

enum PowerConfig {
  CEET_GE
  CEET_UNIQUEMENT
  GE_UNIQUEMENT
  HYBRIDE_GE
  SOLAIRE_UNIQUEMENT
  HYBRIDE_CEET_GE
}

enum StatutGE {
  GE_PERMANENT
  GE_SECOURS
  PAS_DE_GE
}

// Type de pylône du site (les libellés "TGC-GREENFIELD"/"LP-GREENFIELD" utilisent
// un underscore car un identifiant d'enum ne peut pas contenir de tiret).
// Forme de la cuve à gasoil.
enum FormeCuve {
  RECTANGULAIRE
  CYLINDRE_COUCHE
}

enum RoleUser {
  TECHNICIEN
  SUPERVISEUR
  MANAGER
  ADMIN
  DIRECTION
  TRANSPORTEUR
  NOC // centre de supervision réseau : coupures/topologie en écriture, pas d'O&M ni d'admin
}

enum TypeMaintenance {
  PREVENTIVE
  CURATIVE
}

enum StatutMaintenance {
  PLANIFIEE
  EN_COURS
  SUSPENDUE  // interrompue (urgence ailleurs) — reprise exigée avant clôture
  TERMINEE
  ANNULEE
}

enum CategorieEquipement {
  GE
  BATTERIE
  CLIMATISEUR
  ANTENNE
  CABLE
  RESEAU
  AUTRE
}

enum SourceEnergie {
  CEET
  GE
  SOLAIRE
}

// Cycle de vie d'un actif (GE, batterie, climatiseur) suivi par n° de série.
enum StatutActif {
  EN_SERVICE   // posé et en fonctionnement sur un site
  EN_STOCK     // déposé, au dépôt
  EN_TRANSIT   // en cours de déplacement
  REFORME      // retiré du parc
}

// Nature d'une intervention de maintenance (entretien vs cycle de vie d'un actif).
enum NatureTravaux {
  ENTRETIEN
  INSTALLATION
  DESINSTALLATION
  DEPLACEMENT
}

enum TypeIncident {
  ALARME
  COUPURE_CEET
  COUPURE_TOTALE
  PANNE_GE
  INTRUSION
  VANDALISME
  AUTRE
}

enum NiveauSeverite {
  CRITIQUE
  MAJEUR
  MINEUR
  INFORMATIF
}

enum StatutIncident {
  OUVERT
  EN_COURS
  RESOLU
  CLOS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  ASSIGN
  CLOSE
}

// ── Models ────────────────────────────────────────────────────

model User {
  id            String             @id @default(uuid())
  nom           String             @db.VarChar(50)
  prenom        String             @db.VarChar(50)
  email         String             @unique @db.VarChar(100)
  telephone     String?            @db.VarChar(20)
  role          RoleUser
  region        String?            @db.VarChar(50)
  passwordHash  String             @map("password_hash")
  fcmToken      String?            @map("fcm_token")
  isActive      Boolean            @default(true) @map("is_active")
  lastLoginAt   DateTime?          @map("last_login_at")
  // Session unique par plateforme : identifiant de la session en cours (embarqué
  // dans les JWT) — un nouveau login sur la même plateforme éjecte l'ancien.
  sessionWebId    String? @map("session_web_id")
  sessionMobileId String? @map("session_mobile_id")
  prestataireId String?            @map("prestataire_id")
  equipe        EquipeMaintenance?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  prestataire       Prestataire?    @relation(fields: [prestataireId], references: [id])
  maintenances      Maintenance[]   @relation("TechnicienMaintenances")
  depotages         Depotage[]      @relation("TechnicienDepotages")
  releves           ReleveEnergie[]
  incidents         Incident[]      @relation("TechnicienIncidents")
  incidentsDeclares Incident[]      @relation("DeclarantIncidents")
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@index([prestataireId])
  @@map("users")
}

model Site {
  id               String      @id @default(uuid())
  nom              String      @db.VarChar(100)
  code             String      @unique @db.VarChar(20)
  region           String      @db.VarChar(50)
  ville            String?     @db.VarChar(50)
  adresse          String?
  latitude         Decimal?    @db.Decimal(10, 8)
  longitude        Decimal?    @db.Decimal(11, 8)
  powerConfig      PowerConfig @map("power_config")
  statutGE         StatutGE    @map("statut_ge")
  puissanceGEkva   Decimal     @default(0) @map("puissance_ge_kva") @db.Decimal(6, 2)
  // Infrastructure du site
  hasClimatiseur   Boolean     @default(false) @map("has_climatiseur")
  hasExtincteurs   Boolean     @default(false) @map("has_extincteurs")
  typePylone       String?     @map("type_pylone") @db.VarChar(40) // code du référentiel types_pylone
  cuveVolumeLitres Decimal?    @map("cuve_volume_litres") @db.Decimal(8, 2)
  formeCuve        FormeCuve?  @map("forme_cuve")
  cuveDimensions   String?     @map("cuve_dimensions") @db.VarChar(100)
  // Gardiennage et contact local (préparation d'intervention, litiges manquants)
  hasGardien         Boolean  @default(false) @map("has_gardien")
  societeGardiennage String?  @map("societe_gardiennage") @db.VarChar(100) // texte hérité (affiché tant que non rapproché)
  // Société de gardiennage NORMALISÉE : lien vers un prestataire isGardiennage.
  gardiennagePrestataireId String? @map("gardiennage_prestataire_id")
  telephoneSite      String?  @map("telephone_site") @db.VarChar(30)
  isActive         Boolean     @default(true) @map("is_active")
  lotId            String?     @map("lot_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  lot             Lot?                @relation(fields: [lotId], references: [id])
  gardiennagePrestataire Prestataire? @relation("GardiennageSites", fields: [gardiennagePrestataireId], references: [id])
  maintenances    Maintenance[]
  depotages       Depotage[]
  releves         ReleveEnergie[]
  incidents       Incident[]
  groupes         GroupeElectrogene[]
  coupuresReseau  CoupureReseau[]
  // Topologie de transmission : site AMONT dont dépend le lien de ce site.
  parentTransmissionId String? @map("parent_transmission_id")
  parentTransmission   Site?   @relation("TransmissionSite", fields: [parentTransmissionId], references: [id])
  // Type de la liaison vers le site amont (FIBER, TN, ML, RTN…) — le référentiel
  // (famille fibre/FH, constructeur) est paramétrable dans SystemSettings.
  typeLiaison          String? @map("type_liaison")
  enfantsTransmission  Site[]  @relation("TransmissionSite")
  equipementsActifs EquipementActif[]
  lignesLivraison LigneLivraison[]

  @@index([region])
  @@index([statutGE])
  @@index([powerConfig])
  @@index([lotId])
  @@index([gardiennagePrestataireId])
  @@map("sites")
}

// Groupe électrogène d'un site. Un site peut en avoir plusieurs (1, 2, 3…).
// Chaque GE a son propre compteur horaire ; la cuve à gasoil est partagée au niveau du site.
model GroupeElectrogene {
  id           String      @id @default(uuid())
  siteId       String?     @map("site_id")   // null = au dépôt (actif déposé)
  numero       Int         // 1, 2, 3…
  puissanceKva Decimal     @default(0) @map("puissance_kva") @db.Decimal(6, 2)
  statut       StatutGE    @default(GE_SECOURS)        // rôle sur site (permanent/secours)
  numeroSerie  String?     @unique @map("numero_serie") // identité physique de l'actif
  marque       String?     @db.VarChar(60)              // constructeur (pièces, gammes d'entretien)
  statutActif  StatutActif @default(EN_SERVICE) @map("statut_actif")
  isActive     Boolean     @default(true) @map("is_active")
  // Vidange conditionnée aux heures de marche : index horaire relevé à la
  // dernière vidange confirmée (ces champs suivent l'ACTIF, pas le site).
  indexHeuresDerniereVidange Decimal?  @map("index_heures_derniere_vidange") @db.Decimal(10, 1)
  dateDerniereVidange        DateTime? @map("date_derniere_vidange")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // SetNull (et non Cascade) : supprimer un site ne détruit plus l'historique du GE.
  site          Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  releves       ReleveEnergie[]
  depotageHeures DepotageHeureGE[]

  @@unique([siteId, numero])
  @@index([siteId])
  @@map("groupes_electrogenes")
}

// Actif déplaçable hors GE (batterie, climatiseur…), suivi par n° de série.
model EquipementActif {
  id          String              @id @default(uuid())
  categorie   CategorieEquipement // BATTERIE, CLIMATISEUR…
  numeroSerie String?             @unique @map("numero_serie")
  libelle     String?             // ex. « Batterie 200 Ah », « Clim 12000 BTU »
  valeur      Decimal?            @db.Decimal(10, 2) // caractéristique (Ah, BTU, kVA…)
  unite       String?             @db.VarChar(10)
  statutActif StatutActif         @default(EN_SERVICE) @map("statut_actif")
  siteId      String?             @map("site_id") // null = au dépôt
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([categorie])
  @@map("equipements_actifs")
}

model Maintenance {
  id             String              @id @default(uuid())
  reference      String?             @unique @db.VarChar(20) // MNT-2026-00481 (lisible, séquentiel par année)
  siteId         String              @map("site_id")
  incidentId     String?             @map("incident_id")
  type           TypeMaintenance
  categorie      CategorieEquipement
  equipement     String              @db.VarChar(100)
  description    String?
  statut         StatutMaintenance   @default(PLANIFIEE)
  datePlanifiee  DateTime            @map("date_planifiee")
  dateDebut      DateTime?           @map("date_debut")
  dateFin        DateTime?           @map("date_fin")
  dureeMinutes   Int?                @map("duree_minutes")
  // Déclaration du technicien à la clôture : agent de gardiennage présent sur
  // site ? (null = clôturé avant la mise en place / ancien client)
  agentPresent   Boolean?            @map("agent_present")
  // Suspension (urgence sur un autre site) : le temps suspendu est décompté de
  // la durée travaillée ; dateSuspension non-null = pause en cours.
  dureeSuspendueMinutes Int          @default(0) @map("duree_suspendue_minutes")
  dateSuspension        DateTime?    @map("date_suspension")
  motifSuspension       String?      @map("motif_suspension") @db.VarChar(200)
  technicienId   String?             @map("technicien_id")
  prestataireId  String?             @map("prestataire_id")
  signaturePath  String?             @map("signature_path")
  rapportPdfPath String?             @map("rapport_pdf_path")
  observations   String?
  analyseEnergie String?            @map("analyse_energie")
  tachePreventiveKey String?         @map("tache_preventive_key") @db.VarChar(40)
  // Travaux de cycle de vie d'un actif (installation / désinstallation / déplacement).
  natureTravaux  NatureTravaux       @default(ENTRETIEN) @map("nature_travaux")
  actifType      String?             @map("actif_type") @db.VarChar(20) // 'GE'|'BATTERIE'|'CLIMATISEUR' (polymorphe)
  actifId        String?             @map("actif_id")
  siteSourceId   String?             @map("site_source_id") // déplacement : site d'origine (siteId = destination)
  latitudeDebut  Decimal?            @map("latitude_debut") @db.Decimal(10, 8)
  longitudeDebut Decimal?            @map("longitude_debut") @db.Decimal(11, 8)
  isSynced       Boolean             @default(true) @map("is_synced")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  site        Site            @relation(fields: [siteId], references: [id])
  incident    Incident?       @relation(fields: [incidentId], references: [id])
  technicien  User?           @relation("TechnicienMaintenances", fields: [technicienId], references: [id])
  prestataire Prestataire?    @relation(fields: [prestataireId], references: [id])
  pieces      PieceRechange[]
  photos      Photo[]
  releves     ReleveEnergie[]

  @@index([siteId])
  @@index([technicienId])
  @@index([prestataireId])
  @@index([datePlanifiee])
  @@index([statut])
  @@index([tachePreventiveKey])
  @@map("maintenances")
}

model PieceRechange {
  id            String   @id @default(uuid())
  maintenanceId String   @map("maintenance_id")
  nom           String   @db.VarChar(100)
  reference     String?  @db.VarChar(50)
  quantite      Int
  coutUnitaire  Decimal? @map("cout_unitaire") @db.Decimal(10, 2)

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@map("pieces_rechange")
}

model Photo {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type") @db.VarChar(30)
  entityId   String   @map("entity_id")
  url        String
  minioKey   String   @map("minio_key")
  createdAt  DateTime @default(now()) @map("created_at")
  // AVANT (état des lieux au démarrage) / APRES (clôture) — null : non phasée.
  phase      String?  @map("phase") @db.VarChar(10)

  // Table polymorphe (entityType + entityId) : maintenance, dépotage…
  // La contrainte FK DB vers maintenances a été retirée (migration 16) pour
  // autoriser d'autres entités. Cette relation reste utile aux lectures côté
  // maintenance (jointure sur entityId) — NE PAS recréer la contrainte FK.
  maintenance Maintenance? @relation(fields: [entityId], references: [id])

  @@index([entityType, entityId])
  @@map("photos")
}

model Depotage {
  id                 String   @id @default(uuid())
  reference          String?  @unique @db.VarChar(20) // DEP-2026-01893
  siteId             String   @map("site_id")
  dateDepotage       DateTime @map("date_depotage")
  volumeLitres       Decimal  @map("volume_litres") @db.Decimal(8, 2)
  stockAvantLitres   Decimal? @map("stock_avant_litres") @db.Decimal(8, 2)
  stockApresLitres   Decimal? @map("stock_apres_litres") @db.Decimal(8, 2)
  fournisseur        String?  @db.VarChar(100)
  numeroBonLivraison String?  @map("numero_bon_livraison") @db.VarChar(50)
  prixLitre          Decimal? @map("prix_litre") @db.Decimal(6, 0)
  coutTotal          Decimal? @map("cout_total") @db.Decimal(12, 0)
  technicienId       String?  @map("technicien_id")
  signaturePath      String?  @map("signature_path")
  bonLivraisonPath   String?  @map("bon_livraison_path")
  // Validation tripartite du dépotage (signatures sur site)
  nomChauffeur                String? @map("nom_chauffeur") @db.VarChar(100)
  signatureChauffeurPath      String? @map("signature_chauffeur_path")
  nomAgentSecurite            String? @map("nom_agent_securite") @db.VarChar(100)
  agentPresent                Boolean? @map("agent_present") // agent de gardiennage présent au dépotage ?
  signatureAgentSecuritePath  String? @map("signature_agent_securite_path")
  signatureTechnicienPath     String? @map("signature_technicien_path")
  observations       String?
  latitude           Decimal? @db.Decimal(10, 8)
  longitude          Decimal? @db.Decimal(11, 8)
  isSynced           Boolean  @default(true) @map("is_synced")
  // Rattachement à la ligne du plan de livraison (chaîne BC → BL → plan → site)
  ligneLivraisonId   String?  @map("ligne_livraison_id")
  // Réconciliation carburant au dépotage
  volumeAnnonceLitres  Decimal? @map("volume_annonce_litres") @db.Decimal(8, 2)  // déclaré au BL/bordereau
  gasoilAttenduLitres  Decimal? @map("gasoil_attendu_litres") @db.Decimal(8, 2)  // conso attendue depuis le dépotage précédent
  ecartConsoLitres     Decimal? @map("ecart_conso_litres") @db.Decimal(8, 2)     // baisse cuve réelle − attendue
  ecartLivraisonLitres Decimal? @map("ecart_livraison_litres") @db.Decimal(8, 2) // volume jauge réel − annoncé
  analyseDepotage      String?  @map("analyse_depotage")
  createdAt          DateTime @default(now()) @map("created_at")

  site           Site               @relation(fields: [siteId], references: [id])
  technicien     User?              @relation("TechnicienDepotages", fields: [technicienId], references: [id])
  ligneLivraison LigneLivraison?    @relation(fields: [ligneLivraisonId], references: [id])
  heuresGE       DepotageHeureGE[]

  @@index([siteId])
  @@index([dateDepotage])
  @@index([ligneLivraisonId])
  @@map("depotages")
}

// Index horaire d'un GE relevé AU MOMENT du dépotage (un par GE actif).
// Permet la réconciliation conso entre deux dépotages (heures × puissance).
model DepotageHeureGE {
  id            String  @id @default(uuid())
  depotageId    String  @map("depotage_id")
  groupeId      String? @map("groupe_id")
  indexHeuresGE Decimal @map("index_heures_ge") @db.Decimal(10, 2)

  depotage Depotage           @relation(fields: [depotageId], references: [id], onDelete: Cascade)
  groupe   GroupeElectrogene? @relation(fields: [groupeId], references: [id])

  @@index([depotageId])
  @@map("depotage_heures_ge")
}

model ReleveEnergie {
  id                 String        @id @default(uuid())
  siteId             String        @map("site_id")
  dateReleve         DateTime      @map("date_releve")
  source             SourceEnergie
  indexCompteur      Decimal?      @map("index_compteur") @db.Decimal(10, 2)
  consommationKwh    Decimal?      @map("consommation_kwh") @db.Decimal(10, 2)
  volumeGasoilLitres Decimal?      @map("volume_gasoil_litres") @db.Decimal(8, 2)
  indexHeuresGE      Decimal?      @map("index_heures_ge") @db.Decimal(10, 1)
  heuresFonctGE      Decimal?      @map("heures_fonct_ge") @db.Decimal(8, 1)
  gasoilConsommeLitres Decimal?    @map("gasoil_consomme_litres") @db.Decimal(8, 2)
  puissanceKva       Decimal?      @map("puissance_kva") @db.Decimal(6, 2)
  coutEstime         Decimal?      @map("cout_estime") @db.Decimal(12, 0)
  technicienId       String?       @map("technicien_id")
  maintenanceId      String?       @map("maintenance_id")
  groupeId           String?       @map("groupe_id")
  observations       String?
  latitude           Decimal?      @db.Decimal(10, 8)
  longitude          Decimal?      @db.Decimal(11, 8)
  isSynced           Boolean       @default(true) @map("is_synced")
  createdAt          DateTime      @default(now()) @map("created_at")

  site        Site               @relation(fields: [siteId], references: [id])
  technicien  User?              @relation(fields: [technicienId], references: [id])
  maintenance Maintenance?       @relation(fields: [maintenanceId], references: [id])
  groupe      GroupeElectrogene? @relation(fields: [groupeId], references: [id])

  @@index([siteId])
  @@index([dateReleve])
  @@index([source])
  @@index([maintenanceId])
  @@index([groupeId])
  @@map("releves_energie")
}

model Incident {
  id                       String         @id @default(uuid())
  reference                String?        @unique @db.VarChar(20) // INC-2026-00112
  siteId                   String         @map("site_id")
  type                     TypeIncident
  severite                 NiveauSeverite
  statut                   StatutIncident @default(OUVERT)
  description              String
  dateOuverture            DateTime       @default(now()) @map("date_ouverture")
  dateIntervention         DateTime?      @map("date_intervention")
  dateResolution           DateTime?      @map("date_resolution")
  delaiInterventionMinutes Int?           @map("delai_intervention_minutes")
  dureeCoupureMinutes      Int?           @map("duree_coupure_minutes")
  technicienId             String?        @map("technicien_id")
  declarePar               String?        @map("declare_par")
  agentPresent             Boolean?       @map("agent_present") // agent de sécurité présent à l'intervention ?
  causeProbable            String?        @map("cause_probable")
  actionCorrective         String?        @map("action_corrective")
  signaturePath            String?        @map("signature_path")
  latitude                 Decimal?       @db.Decimal(10, 8)
  longitude                Decimal?       @db.Decimal(11, 8)
  isSynced                 Boolean        @default(true) @map("is_synced")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  site         Site          @relation(fields: [siteId], references: [id])
  technicien   User?         @relation("TechnicienIncidents", fields: [technicienId], references: [id])
  declarant    User?         @relation("DeclarantIncidents", fields: [declarePar], references: [id])
  maintenances Maintenance[]
  coupures     CoupureReseau[]

  @@index([siteId])
  @@index([statut])
  @@index([severite])
  @@index([dateOuverture])
  @@map("incidents")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  action     AuditAction
  resource   String      @db.VarChar(50)
  resourceId String?     @map("resource_id")
  details    Json?
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  userAgent  String?     @map("user_agent")
  success    Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// Référentiel éditable des types de pylône (CRUD admin web) — remplace l'ancien enum figé.
model TypePyloneRef {
  code      String   @id @db.VarChar(40)
  libelle   String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("types_pylone")
}

model SystemSettings {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum FrequenceTache {
  MENSUELLE
  TRIMESTRIELLE
  SEMESTRIELLE
  AU_BESOIN
}

// Surcharge admin (libellé + fréquence) d'une tâche préventive contractuelle.
// La clé référence CONTRACTUAL_TASKS (apps/api/src/utils/tachesPreventives.ts) ;
// l'éligibilité et la catégorie restent du code, seuls libellé/fréquence sont éditables.
model TachePreventiveOverride {
  key       String         @id @db.VarChar(40)
  libelle   String
  frequence FrequenceTache
  updatedBy String?        @map("updated_by")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("taches_preventives_overrides")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  body      String
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ── Prestataires de maintenance ───────────────────────────────

enum ScopeMaintenance {
  PASSIVE
  ACTIVE
  LES_DEUX
}

// Équipe d'un technicien chez un prestataire (un agent fait passive OU active).
enum EquipeMaintenance {
  PASSIVE
  ACTIVE
}

model Prestataire {
  id         String   @id @default(uuid())
  nom        String   @db.VarChar(120)
  email      String?  @db.VarChar(100)
  // Coordonnées pour l'en-tête de la fiche de validation
  adresse           String?  @db.VarChar(200)
  rccm              String?  @db.VarChar(60)
  nif               String?  @db.VarChar(40)
  contactCommercial String?  @map("contact_commercial") @db.VarChar(60)
  contactTechnique  String?  @map("contact_technique") @db.VarChar(60)
  logoPath          String?  @map("logo_path")
  // Prestataire de transport carburant (saisit les bons de livraison)
  isTransporteur    Boolean  @default(false) @map("is_transporteur")
  // Société de gardiennage (agents de sécurité des sites — pas d'accès plateforme)
  isGardiennage     Boolean  @default(false) @map("is_gardiennage")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  assignments    LotAssignment[]
  users          User[]
  maintenances   Maintenance[]
  bonsLivraison  BonLivraison[]
  contacts       Contact[]
  sitesGardes    Site[]          @relation("GardiennageSites")

  @@map("prestataires")
}

// Carnet de contacts à notifier (SMS) quand un technicien démarre/clôture une
// action. Indépendant des comptes User : la plupart de ces personnes n'ont pas
// accès à la plateforme. Géré en CRUD par l'admin (+ import Excel).
model Contact {
  id            String   @id @default(uuid())
  nom           String   @db.VarChar(80)
  prenom        String   @db.VarChar(80)
  telephone     String   @unique @db.VarChar(20)
  email         String?  @db.VarChar(100)
  societe       String   @db.VarChar(80) // libellé affiché (INTERNE, NETIS, …)
  prestataireId String?  @map("prestataire_id") // résolu depuis societe quand possible
  actif         Boolean  @default(true)
  // Préférences de notification (configurables par contact)
  notifDemarrage    Boolean @default(true) @map("notif_demarrage")
  notifCloture      Boolean @default(true) @map("notif_cloture")
  notifMaintenances Boolean @default(true) @map("notif_maintenances")
  notifIncidents    Boolean @default(true) @map("notif_incidents")
  // true : reçoit les actions de toutes les sociétés ; false : uniquement celles
  // de sa société (technicien du même prestataire, ou interne si contact interne).
  toutesSocietes Boolean @default(false) @map("toutes_societes")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prestataire Prestataire? @relation(fields: [prestataireId], references: [id])

  @@index([prestataireId])
  @@map("contacts")
}

// Journal des SMS émis (ou simulés tant que la passerelle n'est pas configurée) :
// trace le destinataire, l'événement déclencheur et le résultat.
model SmsLog {
  id        String   @id @default(uuid())
  telephone String   @db.VarChar(20)
  contactId String?  @map("contact_id")
  message   String   @db.VarChar(320)
  evenement String   @db.VarChar(60) // ex: MAINTENANCE_DEMARRAGE, INCIDENT_CLOTURE
  statut    String   @db.VarChar(12) // ENVOYE | ECHEC | SIMULE
  erreur    String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("sms_logs")
}

model Lot {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(30)
  nom       String   @db.VarChar(120)
  region    String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sites       Site[]
  assignments LotAssignment[]

  @@map("lots")
}

// Attribution d'un lot à un prestataire pour un périmètre (passive / active / les deux).
// Un lot peut avoir 1 ligne LES_DEUX, ou 2 lignes (PASSIVE + ACTIVE) chez des prestataires différents.
model LotAssignment {
  id            String           @id @default(uuid())
  lotId         String           @map("lot_id")
  prestataireId String           @map("prestataire_id")
  scope         ScopeMaintenance
  dateDebut     DateTime?        @map("date_debut")
  dateFin       DateTime?        @map("date_fin")
  createdAt     DateTime         @default(now()) @map("created_at")

  lot         Lot         @relation(fields: [lotId], references: [id], onDelete: Cascade)
  prestataire Prestataire @relation(fields: [prestataireId], references: [id])

  @@unique([lotId, prestataireId, scope])
  @@index([prestataireId])
  @@map("lot_assignments")
}

// ── Logistique carburant : Bon de commande → Bon de livraison → Plan de livraison → Sites ──

enum StatutBonCommande {
  OUVERT  // trimestre en cours d'exécution
  CLOTURE // trimestre terminé
  ANNULE
}

enum StatutBonLivraison {
  PLANIFIE // camion à charger
  CHARGE   // chargé, en distribution
  LIVRE    // entièrement distribué
  ANNULE
}

enum StatutLigneLivraison {
  PREVU
  PARTIEL
  LIVRE
  ANNULE
}

// Bon de commande trimestriel : référence principale, volumes répartis par mois.
model BonCommande {
  id           String            @id @default(uuid())
  numero       String            @unique @db.VarChar(50) // identifiant unique du BC
  annee        Int
  trimestre    Int               // 1..4
  numeroClient String            @map("numero_client") @db.VarChar(50) // constant
  statut       StatutBonCommande @default(OUVERT)
  bcPdfPath    String?           @map("bc_pdf_path") // PDF de la commande joint par le manager
  observations String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  volumesMensuels VolumeMensuel[]
  bonsLivraison   BonLivraison[]

  @@index([annee, trimestre])
  @@map("bons_commande")
}

// Volume prévu pour un mois du trimestre d'un bon de commande.
model VolumeMensuel {
  id                String  @id @default(uuid())
  bonCommandeId     String  @map("bon_commande_id")
  mois              Int     // 1..12
  volumePrevuLitres Decimal @map("volume_prevu_litres") @db.Decimal(12, 2)

  bonCommande BonCommande @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)

  @@unique([bonCommandeId, mois])
  @@index([bonCommandeId])
  @@map("volumes_mensuels")
}

// Bon de livraison : un chargement réel de camion, exécutant le volume d'un mois.
model BonLivraison {
  id                 String             @id @default(uuid())
  bonCommandeId      String             @map("bon_commande_id")
  transporteurId     String?            @map("transporteur_id") // prestataire transporteur
  numeroBL           String             @unique @map("numero_bl") @db.VarChar(50) // unique par chargement
  mois               Int                // mois exécuté (1..12)
  annee              Int
  immatriculation    String             @db.VarChar(30) // camion
  volumeChargeLitres Decimal            @map("volume_charge_litres") @db.Decimal(12, 2)
  numeroClient       String             @map("numero_client") @db.VarChar(50)
  dateChargement     DateTime           @map("date_chargement")
  dateTraitement     DateTime?          @map("date_traitement")
  statut             StatutBonLivraison @default(PLANIFIE)
  blPdfPath          String?            @map("bl_pdf_path")        // PDF du bon de livraison
  bordereauPdfPath   String?            @map("bordereau_pdf_path") // PDF du bordereau de chargement
  // Brouillon généré par le réappro prédictif : exclu des agrégats (chargé/livré) jusqu'à finalisation.
  isBrouillon        Boolean            @default(false) @map("is_brouillon")
  observations       String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  bonCommande BonCommande      @relation(fields: [bonCommandeId], references: [id])
  transporteur Prestataire?    @relation(fields: [transporteurId], references: [id])
  lignes      LigneLivraison[]

  @@index([bonCommandeId])
  @@index([transporteurId])
  @@index([annee, mois])
  @@map("bons_livraison")
}

// Ligne du plan de livraison d'un camion : un site et la quantité à y livrer.
// Σ des volumes prévus des lignes = volume chargé du camion.
model LigneLivraison {
  id                String               @id @default(uuid())
  bonLivraisonId    String               @map("bon_livraison_id")
  siteId            String               @map("site_id")
  volumePrevuLitres Decimal              @map("volume_prevu_litres") @db.Decimal(10, 2)
  volumeLivreLitres Decimal?             @map("volume_livre_litres") @db.Decimal(10, 2)
  statut            StatutLigneLivraison @default(PREVU)
  createdAt         DateTime             @default(now()) @map("created_at")

  bonLivraison BonLivraison @relation(fields: [bonLivraisonId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id])
  depotages    Depotage[] // réceptions réelles rattachées à cette ligne

  @@unique([bonLivraisonId, siteId])
  @@index([bonLivraisonId])
  @@index([siteId])
  @@map("lignes_livraison")
}

// Coupure réseau (supervision NOC) : indisponibilité radio par technologie
// (2G/3G/4G/5G) ou site entier. Saisie dans l'app ou importée du rapport Excel.
// NB : l'unicité (site, technologie, frequence, dateDebut) est portée par un
// index SQL avec COALESCE (migration 0029) — pas exprimable en Prisma.
model CoupureReseau {
  id                  String    @id @default(uuid())
  siteId              String    @map("site_id")
  technologie         String    @db.VarChar(12) // 2G | 3G | 4G | 5G | SITE
  frequence           String?   @db.VarChar(30)
  secteur             String?   @db.VarChar(20)
  dateDebut           DateTime  @map("date_debut")
  dateFin             DateTime? @map("date_fin")
  downtimeMinutes     Int?      @map("downtime_minutes")
  heureContact        DateTime? @map("heure_contact")
  technicienContacte  String?   @map("technicien_contacte") @db.VarChar(100)
  dateArriveeSite     DateTime? @map("date_arrivee_site")
  intervenants        String?   @db.VarChar(200)
  cause               String?   @db.VarChar(300)
  actions             String?   @db.VarChar(300)
  typeAlarme          String?   @map("type_alarme") @db.VarChar(10)
  nocEngineer         String?   @map("noc_engineer") @db.VarChar(100)
  observations        String?
  // LOCALE = cause racine sur ce site ; HERITEE = impact d'une coupure amont.
  origine             String    @default("LOCALE") @db.VarChar(10)
  coupureOrigineId    String?   @map("coupure_origine_id")
  // Incident terrain créé automatiquement pour cette coupure (groupé par site).
  incidentId          String?   @map("incident_id")
  // Classement de l'indisponibilité : ACTIF (équipement radio/transmission)
  // ou PASSIF (énergie/environnement — responsabilité O&M du prestataire).
  causeCategorie      String?   @map("cause_categorie") @db.VarChar(10)
  // Coupure PARTIELLE déjà notifiée aux équipes actives (pas d'incident terrain :
  // le site est alimenté, le défaut se traite côté radio/transmission).
  notifieeActif       Boolean   @default(false) @map("notifiee_actif")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  site           Site            @relation(fields: [siteId], references: [id])
  coupureOrigine CoupureReseau?  @relation("CoupureHeritee", fields: [coupureOrigineId], references: [id])
  heritees       CoupureReseau[] @relation("CoupureHeritee")
  incident       Incident?       @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([dateDebut])
  @@index([dateFin])
  @@index([typeAlarme])
  @@index([incidentId])
  @@map("coupures_reseau")
}
